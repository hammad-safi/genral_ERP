{
  "name": "erp-buisness-application",
  "private": true,
  "version": "1.0.0",
  "description": "Offline ERP Application built with Electron, Vite, and React",
  "author": "Muhammad Software Solutions",
  "email": "muhammadowais9219@gmail.com",
  "main": "main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "npm run build && npx electron .",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron . --dev\"",
    "dist": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false CSC_KEY_PASSWORD= electron-builder --win nsis --x64",
    "build-portable": "npm run build && node build-portable.js",
    "electron:start": "electron ."
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.10",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "pg": "^8.11.3",
    "lucide-react": "^0.294.0",
    "node-machine-id": "^1.1.12",
    "qrcode.react": "^4.2.0",
    "react": "^18.2.0",
    "react-barcode": "^1.6.1",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "react-to-print": "^3.3.0",
    "recharts": "^2.10.3"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "archiver": "^7.0.1",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6",
    "vite": "^5.0.8",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.shopErp.app",
    "productName": "Shop ERP - Offline Business Management Software",
    "copyright": "Copyright © 2026 Muhammad Software Solutions",
    "asar": true,
    "compression": "maximum",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "main.cjs",
      "preload.cjs"
    ],
    "win": {
      "target": "nsis",
      "publisherName": "Muhammad Software Solutions",
      "legalTrademarks": "Muhammad Software Solutions",
      "certificateFile": null,
      "certificatePassword": null,
      "forceCodeSigning": false,
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Shop ERP"
    }
  }
}
